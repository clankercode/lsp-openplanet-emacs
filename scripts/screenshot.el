;;; screenshot.el --- Real GUI capture -*- lexical-binding: t; no-byte-compile: t; -*-
;; SPDX-License-Identifier: Unlicense OR CC0-1.0
(require 'openplanet)
(require 'eglot)
(require 'flymake)
(setq inhibit-startup-screen t initial-scratch-message nil
      make-backup-files nil auto-save-default nil
      eglot-sync-connect 15 eglot-autoshutdown t)
(menu-bar-mode -1)
(tool-bar-mode -1)
(scroll-bar-mode -1)
(load-theme 'modus-vivendi t)
(set-face-attribute 'default nil :family "DejaVu Sans Mono" :height 140)
(set-frame-size nil 1440 1000 t)
(set-frame-position nil 0 0)
(setq frame-title-format "GNU Emacs — Openplanet / Eglot")
(openplanet-setup)
(let* ((dir (getenv "OPENPLANET_CAPTURE_DIR"))
       (source (expand-file-name "Main.as" dir)))
  (find-file source)
  (goto-char (point-max))
  (insert "\n// Intentional error for the diagnostics demonstration.\nvoid _DemoError() {\n    int value = MissingName;\n}\n")
  (save-buffer)
  (display-line-numbers-mode 1)
  (call-interactively #'eglot)
  (flymake-start)
  (let ((deadline (+ (float-time) 30)))
    (while (and (not (flymake-diagnostics)) (< (float-time) deadline))
      (accept-process-output nil 0.1)))
  (unless (cl-some (lambda (d) (string-match-p "MissingName" (flymake-diagnostic-text d)))
                   (flymake-diagnostics))
    (error "No real MissingName diagnostic received"))
  (goto-char (point-min))
  (search-forward "MissingName")
  (flymake-show-buffer-diagnostics)
  (select-window (get-buffer-window "Main.as"))
  (set-window-start (selected-window) (point-min))
  (message nil)
  (redisplay t)
  (run-at-time 2 nil
               (lambda ()
                 (with-temp-file (expand-file-name "ready" (getenv "OPENPLANET_CAPTURE_DIR"))
                   (insert "Real Emacs 31.1; Eglot; openplanet-lsp 0.8.0; MissingName diagnostic received.\n")))))
;;; screenshot.el ends here
